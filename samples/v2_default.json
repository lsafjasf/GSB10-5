{
  "name": "image-plugin",
  "version": "1.0.1",
  "functions": {
    "resize": {
      "params": {
        "image":     {"type": "bytes", "required": true},
        "width":     {"type": "int",   "required": true},
        "algorithm": {"type": "str",   "required": false, "default": "bilinear"}
      },
      "returns": {"type": "bytes"},
      "raises": {
        "ValueError": "width <= 0",
        "IOError":    "image 无法解码"
      }
    },
    "convert": {
      "params": {
        "image":  {"type": "bytes", "required": true},
        "format": {"type": "str",   "required": true}
      },
      "returns": {"type": "bytes"},
      "raises": {
        "ValueError": "format 不在支持列表中"
      }
    }
  }
}
